﻿@{
    ViewData["Title"] = "Blogsite";
}

<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<link href="/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
<!-- START PAGE -->
<div class="main">
      <div class="menu_nav">
        <ul>
          <li class=""><a href="../blogs/index">Home</a></li>
          <li><a href="../blogs/about">Over ons</a></li>
          @if(User.Identity.IsAuthenticated){
             <li><a asp-controller="Blogs" asp-action="Logout">Logout</a></li>
          }else{
             <li><a href="/blogs/login">Login</a></li>
          }
          <form method="get" asp-controller="Blogs" asp-action="Search" style="display:inline">
                <input style="margin-top:5px;" type="text" maxlength="20" name="searchString" />
                <input type="image" src="~/images/search_btn.gif" style="height:19px; width:20px; position:relative; top:5px; right:25px;" />
          </form>
           
        </ul>   
      </div>
      <div class="logo">
        <h1><a asp-controller="Blogs" asp-action="Index">You<span>Blog</span></a> 
      </div>
      <div class="clr"></div>
    </div>
  </div>
  <div class="content">
    <div class="content_resize">
          
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
   
    
</div>
<!-- END PAGE  -->
</body>
</html>