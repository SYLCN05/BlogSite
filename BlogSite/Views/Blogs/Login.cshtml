
@{
    Layout = "/Views/Shared/_BlogLayout.cshtml";
}
@model LoginViewModel
<partial name="/Views/Shared/_Notifications.cshtml"/>
<partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />

   <form asp-controller="Blogs" asp-action="LoginConfirm" method="post">
        <div style="display:flex; justify-content:center; align-items:center; flex-direction:column; background-color: limegreen; max-width:580px; margin-left:200px;">
            <h3 style="text-align:center; color:white;">Login</h3>

            <label style="color:white">Gerbuikersnaam</label>
            <input type="text" required asp-for="Username"/>
            <span asp-validation-for="Username" style="color:red"></span>

            <label style="color:white">Wachtwoord</label>
            <input type="password" required asp-for="Password"/>
            <span asp-validation-for="Password" style="color:red"></span>
            <br />
            <input class="btn btn-primary" type="submit" value="Login" style="margin-bottom:5px;" />
            <h4>Nog geen account registreer <a href="/blogs/register">hier<a/></h4>
        </div>
    </form>


