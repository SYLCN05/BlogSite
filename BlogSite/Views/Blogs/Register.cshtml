@{
    Layout = "/Views/Shared/_BlogLayout.cshtml";
}
@model User
<partial name="/Views/Shared/_Notifications.cshtml" />

<form asp-controller="Blogs" asp-action="RegisterConfirm" method="post">
    <div style="display:flex; justify-content:center; align-items:center; flex-direction:column; background-color: limegreen; max-width:580px; margin-left:200px;">
        <h3 style="text-align:center; color:white;">Register</h3>
        <label style="color:white">Gerbuikersnaam</label>
        <input type="text" required asp-for="Username" placeholder="Gebruikersnaam" />
        <label style="color:white">Wachtwoord</label>
        <input type="password" required asp-for="Password" placeholder="Wachtwoord"/>
        <br />
        <input class="btn btn-primary" type="submit" value="Verstuur" style="margin-bottom:5px;" />
    </div>
</form>


