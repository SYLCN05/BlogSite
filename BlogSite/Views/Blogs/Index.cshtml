@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Blog>
<link rel="stylesheet" href="/css/Index.css" />
@{
    Layout = "/Views/Shared/_BlogLayout.cshtml";
    ViewBag.Title = "Blogs";
}
@if(User.IsInRole("Admin")){
    <a style="text-decoration:none; color:white; background-color:limegreen; border-radius:5px; margin-left:400px; padding:20px;" href="../blogs/CreateBlog">Nieuwe blog</a>
}


<div class="mainbar" style="margin-left:120px; margin-top:30px;">
    @foreach(var blog in Model)
    {
        <div class="article">
            <h2><span>@blog.Name</span></h2>
            <div class="clr"></div>
            <p>
                <span class="date">@blog.PublishDate.ToString("MMMM d\\s\\t\\e, yyyy 'om' h:mm tt")</span> | Tags: <a href="#">@blog.Tags</a>
            @* <img src="/images/img1.jpg" width="625" height="205" alt="" /> *@
            <img src="@blog.ImageUrl" width="625" height="205" alt="" />
            @* @{
                string oldDescription = blog.Description;
                string newDescription = oldDescription.Length > 50 ? oldDescription.Substring(0,250) + "..." : oldDescription;
            } *@
            @* <p>@newDescription</p> *@
            <p class="spec"><a asp-controller="Blogs" asp-action="Details" asp-route-id="@blog.Id" class="rm">Lees meer</a> 
                <a href="#" style="margin-left:5px;"><span>@blog.CommentCount</span> Comments</a>
                <a href="#" style="margin-left:5px;" ><span>@blog.ViewCount</span> Views</a>
            </p>
            @if (User.IsInRole("Admin"))
            {
               <a asp-controller="Blogs" asp-action="DeleteBlog" asp-route-id="@blog.Id"><img src="/images/Delete.png" style="height:50px; width:50px; margin-bottom:5px;" /></a>
            }
                
        </div>
       
    }


    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
    new PagedListRenderOptions
    {
     UlElementClasses = new[] {"CustomPagnitation"},
     LiElementClasses = new[] {"Custom-page-item"},
     PageClasses = new[]{"Custom-page-link"}
    }
    )

  
   
</div>